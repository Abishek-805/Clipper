{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Clipper anime highlight evaluation dataset",
  "type": "object",
  "required": ["schema", "schema_version", "source", "candidate_count", "candidates", "annotations"],
  "properties": {
    "schema": {"const": "clipper-anime-evaluation-v1"},
    "schema_version": {"const": 1},
    "annotation_policy": {"type": "string"},
    "source": {"type": "object", "required": ["filename", "fingerprint", "duration"], "properties": {
      "filename": {"type": "string"}, "path": {"type": ["string", "null"]},
      "fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "duration": {"type": "number", "exclusiveMinimum": 0},
      "size": {"type": "integer", "minimum": 0}, "mtime_ns": {"type": "integer", "minimum": 0}
    }},
    "candidate_count": {"type": "integer", "minimum": 0},
    "candidates": {"type": "array", "items": {"type": "object", "required": ["candidate_id", "start", "end", "score", "selected", "reviewer_label"], "properties": {
      "candidate_id": {"type": "string"}, "start": {"type": "number", "minimum": 0}, "end": {"type": "number", "exclusiveMinimum": 0},
      "score": {"type": "number"}, "selected": {"type": "boolean"}, "reviewer_label": {"type": "null"}
    }}},
    "annotations": {"type": "array", "items": {"type": "object", "required": ["candidate_id", "source_fingerprint", "source_interval", "decision", "category", "annotated_at"], "properties": {
      "candidate_id": {"type": "string"}, "source_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
      "source_interval": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "minItems": 2, "maxItems": 2},
      "decision": {"enum": ["keep", "reject", "maybe"]}, "category": {"type": "string"},
      "ratings": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1, "maximum": 5}},
      "rejection_reasons": {"type": "array", "items": {"type": "string"}}, "notes": {"type": "string"}, "annotated_at": {"type": "string", "minLength": 1}
    }}}
  }
}
